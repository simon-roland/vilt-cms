<?php

namespace App\Cms;

use Filament\Schemas\Components\Tabs\Tab;

class SiteSettingsSchema
{
    /**
     * Return additional settings tabs to append after the CMS defaults
     * (General, Social Media, SEO, Scripts).
     *
     * Example:
     *
     *   Tab::make('My Settings')
     *       ->schema([
     *           \Filament\Forms\Components\TextInput::make('phone')
     *               ->label('Phone number'),
     *       ]),
     *
     * With multiple locales configured, chain ->translatable() on any field
     * to make it overridable per locale (see README → Localization):
     *
     *   \Filament\Forms\Components\TextInput::make('tagline')
     *       ->label('Tagline')
     *       ->translatable(),
     */
    public static function extraTabs(): array
    {
        return [
            //
        ];
    }
}
